# Template only. Copy to `.env` (gitignored) for the Flutter app + setup script.
# Supabase Dashboard → Project Settings → API

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional — DDL auto-apply for the setup script
# Database → Connection string → URI
# SUPABASE_DB_URL=postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Optional — for setup script verify
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Auth: create users in Authentication → Users (e.g. aditya.rana@sayge.in).
# The app uses Supabase Auth only — no demo login.
